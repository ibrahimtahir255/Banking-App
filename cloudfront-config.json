{
    "CallerReference": "student-ibrahimtahir-bank-frontend-2026-07-31",
    "Comment": "CloudFront for Pig Bank frontend",
    "Enabled": true,
    "DefaultRootObject": "index.html",
    "Origins": {
        "Quantity": 1,
        "Items": [
            {
                "Id": "S3WebsiteOrigin",
                "DomainName": "student-ibrahimtahir-bank-frontend.s3-website-us-east-1.amazonaws.com",
                "CustomOriginConfig": {
                "HTTPPort": 80,
                "HTTPSPort": 443,
                "OriginProtocolPolicy": "http-only",
                "OriginSslProtocols": { "Quantity": 1, "Items": ["TLSv1.2"] }
            }
        }
    ]
},
"DefaultCacheBehavior": {
    "TargetOriginId": "S3WebsiteOrigin",
    "ViewerProtocolPolicy": "redirect-to-https",
    "AllowedMethods": {
        "Quantity": 2,
        "Items": ["GET", "HEAD"],
        "CachedMethods": { "Quantity": 2, "Items": ["GET", "HEAD"] }
    },
    "ForwardedValues": {
        "QueryString": false,
        "Cookies": { "Forward": "none" }
    },
    "MinTTL": 0,
    "DefaultTTL": 86400,
    "MaxTTL": 31536000,
    "TrustedSigners": { "Enabled": false, "Quantity": 0 }
}
}